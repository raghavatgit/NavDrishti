<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06090F"
    android:fitsSystemWindows="true">

    <!-- Top Mode Switcher Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#0D121C"
        android:padding="4dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnTabNavMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Navigation Map"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_selected"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnTabTelemetry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ISRO Telemetry"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_tab_unselected"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Main Container: Map or Telemetry -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- VIEW 1: Fullscreen Google Maps Turn-by-Turn Navigation -->
        <WebView
            android:id="@+id/webViewNavMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- VIEW 2: Aerospace 100 Hz EKF Telemetry Cockpit -->
        <LinearLayout
            android:id="@+id/layoutTelemetryView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_cockpit"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Header & App Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_logo"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="NavDrishti Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_tagline"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100 Hz EKF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:background="#1A00F3FF"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- Status Banner -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_standby"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_green"
                android:background="#1500F090"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="10dp" />

            <!-- Scrollable Telemetry View -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Cockpit Card 1: Speedometer & Attitude Horizon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_cockpit_card"
                        android:padding="14dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VEHICLE VELOCITY &amp; ATTITUDE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/tvSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/initial_speed"
                                android:textSize="48sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_cyan"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" km/h"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="6dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:id="@+id/tvHeading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="342 deg NNW"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:id="@+id/tvPitchRoll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="P: +1.2 deg  R: -0.4 deg"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Cockpit Card 2: ISRO NavIC / GNSS Constellation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_cockpit_card"
                        android:padding="14dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONSTELLATION &amp; SIGNAL LOCK"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ISRO NavIC"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvNavicCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="7 SVs (L5/S)"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_green" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="GPS / Galileo"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvGpsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="14 SVs"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNavicFreq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="L5 Band (1176.45 MHz) Dual-Frequency Lock"
                            android:textSize="11sp"
                            android:textColor="@color/accent_cyan"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Cockpit Card 3: Dead Reckoning Performance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_cockpit_card"
                        android:padding="14dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BLACKOUT DEAD RECKONING ACCURACY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Traversed in Tunnel"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvTunnelDist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.0 m"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Drift Error"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvDriftPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.14% (Pass)"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_green" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Bottom Thumb Zone Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnToggleService"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_start_engine"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#06090F"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSimulateBlackout"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="@string/btn_simulate_blackout"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_danger"
                        android:background="@drawable/bg_btn_danger"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnCalibrateMount"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="@string/btn_calibrate_imu"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_cockpit_card"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
